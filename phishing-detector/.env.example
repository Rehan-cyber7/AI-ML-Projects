# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to version control.

# Threat-intelligence / domain reputation API
THREAT_INTEL_API_KEY=[YOUR_API_KEY]
THREAT_INTEL_API_URL=https://your-threat-intel-provider.example/api/v3

# Optional third-party screenshot service (alternative to local Selenium)
SCREENSHOT_API_KEY=[YOUR_API_KEY]
SCREENSHOT_API_URL=https://your-screenshot-provider.example/capture

# Flask / model
FLASK_ENV=production
MODEL_PATH=models/phishing_model.joblib
ENABLE_SCREENSHOT_LAYER=false
